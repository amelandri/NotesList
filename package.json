{
	"name": "notes-list",
	"version": "0.1.4",
	"description": "Obsidian plugin: chronological list of notes in a folder, with date/time, content and tags",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"install-to-vault": "node copy-to-vault.mjs",
		"deploy": "npm run build && npm run install-to-vault",
		"generate-test-notes": "node generate-test-notes.mjs",
		"release": "node release.mjs",
		"test": "vitest run"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.5",
		"esbuild": "^0.20.0",
		"moment": "2.29.4",
		"obsidian": "^1.13.1",
		"tslib": "2.6.2",
		"typescript": "^5.3.3",
		"vitest": "^1.6.1"
	}
}
