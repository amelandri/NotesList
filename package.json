{
	"name": "notes-list",
	"version": "0.2.0",
	"description": "Obsidian plugin: chronological list of notes in a folder, with date/time, content and tags",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && eslint . --max-warnings 0 && node esbuild.config.mjs production",
		"lint": "eslint . --max-warnings 0",
		"install-to-vault": "node copy-to-vault.mjs",
		"deploy": "npm run build && npm run install-to-vault",
		"generate-test-notes": "node generate-test-notes.mjs",
		"release": "node release.mjs",
		"test": "vitest run"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^20.11.5",
		"esbuild": "^0.20.0",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "^1.13.1",
		"tslib": "2.6.2",
		"typescript": "^5.3.3",
		"typescript-eslint": "^8.71.0",
		"vitest": "^1.6.1"
	}
}
